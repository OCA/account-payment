<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.early.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_apply_early_payment"
                    type="object"
                    string="Apply Early Payment"
                    class="btn-primary"
                    invisible="not early_payment_can_apply"
                    confirm="A credit note for the early payment discount will be created and applied to this invoice. Continue?"
                />
            </xpath>
            <field name="invoice_payment_term_id" position="after">
                <field name="early_payment_date" invisible="not early_payment_date" />
                <field name="early_payment_amount" invisible="not early_payment_date" />
                <field
                    name="early_payment_credit_note_id"
                    invisible="not early_payment_credit_note_id"
                />
            </field>
        </field>
    </record>
</odoo>
