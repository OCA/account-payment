#. module: payment_taler
#: model_terms:ir.ui.view,arch_db:payment_taler.payment_provider_form
msgid ""
"Test mode is enabled. This mode allows you to test the payment process by running test payments with Taler and the chosen Merchant.<br/>\n"
"                    In the Odoo UI, these payments' information will be displayed with actual values (amount, currency, etc), but the currency will automatically be swapped to \"Kudos\" right before sending the order to the Taler merchant.<br/>\n"
"                    KUDOS is an imaginary currency created for Taler. It can be used for free to test transactions with your order wallet. The selected merchant needs to be compatible with Kudos (most Taler merchants are compatible with Kudos).<br/>"
msgstr ""

