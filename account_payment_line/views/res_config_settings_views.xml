<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.account.payment.line</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block
                    title="Payments"
                    name="payment_line_counterpart_setting_container"
                >
                    <setting
                        id="payment_line_restrict_counterpart_partner_setting"
                        string="Restrict counterpart lines to payment partner"
                        company_dependent="1"
                        help="Only allow applying invoices of the partner set on the payment header in the counterpart lines."
                    >
                        <field name="payment_line_restrict_counterpart_partner" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
