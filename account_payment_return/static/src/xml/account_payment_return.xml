<templates xml:space="preserve">

    <t t-inherit="account.AccountPaymentField" t-inherit-mode="extension">
        <xpath expr="//a[contains(@class, 'js_payment_info')]" position="attributes">
            <attribute
                name="t-att-data-icon"
            >line.returned and 'warning' or 'info'</attribute>
            <attribute name="title">Payment Info</attribute>
        </xpath>

        <xpath
            expr="//i[@class='o_field_widget text-start o_payment_label']"
            position="replace"
        >
            <i class="o_field_widget text-start o_payment_label">
                <t t-if="line.returned">Returned on </t>
                <t t-elif="line.is_refund">Reversed on </t>
                <t t-else="">Paid on </t>
                <t t-out="line.formattedDate" />
            </i>
        </xpath>
    </t>
</templates>
