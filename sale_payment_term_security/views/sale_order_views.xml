<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form (in sale_payment_term_security)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">not is_account_payment_term_mgmt</attribute>
                <attribute name="force_save">not is_account_payment_term_mgmt</attribute>
            </xpath>
        </field>
    </record>
</odoo>
