        id="mail_activity_team_early_payment_credit_note"
        model="mail.activity.team"
    >
        <field name="name">Early Payment Credit Notes</field>
        <field name="res_model_ids" eval="[(4, ref('account.model_account_move'))]" />
    </record>
</odoo>
