<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.supplier.early.payment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <group name="purchase" position="after">
                <group name="early_payment" string="Early Payment">
                    <field name="early_payment_percent" />
                    <field name="early_payment_percent_2" />
                    <field name="early_payment_days" />
                    <field name="early_payment_base" />
                </group>
            </group>
        </field>
    </record>
</odoo>
