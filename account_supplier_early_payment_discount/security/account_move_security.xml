<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_group_early_payment_credit_note" model="res.groups">
        <field name="name">Follow Up Early Payment Credit Notes</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting" />
    </record>
    <!-- Accounting managers chase the credit notes unless told otherwise. -->
    <record id="account.group_account_manager" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('account_move_group_early_payment_credit_note'))]"
        />
    </record>
</odoo>
