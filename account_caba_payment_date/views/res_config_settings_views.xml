<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.caba.payment.date</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="tax_exigibility" position="inside">
                <div class="content-group" invisible="not tax_exigibility">
                    <div class="row mt16">
                        <label
                            for="caba_payment_date_lock_policy"
                            class="col-lg-4 o_light_label"
                        />
                        <field name="caba_payment_date_lock_policy" />
                    </div>
                </div>
            </setting>
        </field>
    </record>
</odoo>
