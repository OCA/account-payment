<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form (in account_payment_term_security)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                <attribute name="readonly">state in ['cancel', 'posted'] or not is_account_payment_term_mgmt</attribute>
                <attribute name="force_save">not is_account_payment_term_mgmt</attribute>
            </xpath>
        </field>
    </record>
</odoo>
