<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Link EasyPay provider to existing payment methods -->
    <function model="payment.provider" name="write">
        <value eval="[ref('payment_provider_easypay')]" />
        <value
            eval="{'payment_method_ids': [(4, ref('payment.payment_method_card'))]}"
        />
    </function>
</odoo>
